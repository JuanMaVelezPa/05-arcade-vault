# Generate a key from the Resend dashboard: https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives the contact form messages (no fallback: the route returns 500 without it)
CONTACT_TO_EMAIL=

# Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
